      "status": "poc",
      "commands": {
        "azure.connectivity.check": ["go", "run", "./adapters/go/cmd/windows-provider-check", "--pod", "azure"],
        "microsoft-store.connectivity.check": ["go", "run", "./adapters/go/cmd/windows-provider-check", "--pod", "microsoft-store"]
      }
    },
    "rust": {"status": "planned", "commands": {}},
    "python": {"status": "planned", "commands": {}}
