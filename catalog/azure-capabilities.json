{
  "schema_version": 1,
  "provider": "azure",
  "scope": "application and service deployment control plane",
  "reviewed_on": "2026-09-12",
  "discovery": {
    "provider_metadata": "GET https://management.azure.com/subscriptions/{subscriptionId}/providers?api-version=2021-04-01",
    "resource_graph": "POST https://management.azure.com/providers/Microsoft.ResourceGraph/resources?api-version=2024-04-01",
    "openapi_source": "https://github.com/Azure/azure-rest-api-specs",
    "rule": "pin an api-version per capability; never silently adopt preview versions"
  },
  "capabilities": [
    {"id":"azure.connectivity.check","feature":"identity and subscription access","method":"GET","path":"/subscriptions/{subscriptionId}?api-version=2022-12-01","command":"az account show","input":["tenantId","clientId","credential","subscriptionId"],"output":["subscription id","tenant id","state"],"permission":"Reader at subscription or narrower probe scope","risk":"read_only","monitor":["http_status","request_id","latency","credential_age"],"cost":"none per request"},
    {"id":"azure.subscription.list","feature":"list accessible subscriptions","method":"GET","path":"/subscriptions?api-version=2022-12-01","command":"az account list","input":["access token"],"output":["subscriptions"],"permission":"tenant-authorized principal","risk":"read_only","monitor":["count","latency","permission_denial"],"cost":"none per request"},
    {"id":"azure.provider.list","feature":"discover resource providers and API versions","method":"GET","path":"/subscriptions/{subscriptionId}/providers?api-version=2021-04-01","command":"az provider list","input":["subscriptionId"],"output":["namespaces","resourceTypes","apiVersions","locations"],"permission":"Reader","risk":"read_only","monitor":["schema_drift","provider_registration_state"],"cost":"none per request"},
    {"id":"azure.resource.list","feature":"cross-resource inventory","method":"POST","path":"/providers/Microsoft.ResourceGraph/resources?api-version=2024-04-01","command":"az graph query","input":["subscriptions","query"],"output":["resources","facets","skipToken"],"permission":"Reader on queried scopes","risk":"read_only","monitor":["result_count","throttle","query_latency"],"cost":"none per request"},
    {"id":"azure.resource_group.manage","feature":"resource group lifecycle","method":"GET|PUT|DELETE","path":"/subscriptions/{subscriptionId}/resourcegroups/{resourceGroupName}","command":"az group show|create|delete","input":["name","location","tags"],"output":["resource group","provisioning state"],"permission":"Resource Group Contributor or custom","risk":"approval_required","monitor":["activity_log","deployment_state"],"cost":"group none; contained resources billed"},
    {"id":"azure.deployment.what_if","feature":"preview ARM/Bicep changes","method":"POST","path":"/{scope}/providers/Microsoft.Resources/deployments/{name}/whatIf?api-version=2025-04-01","command":"az deployment group what-if","input":["template","parameters","scope"],"output":["changes","diagnostics"],"permission":"deployment write validation at scope","risk":"read_only","monitor":["change_count","policy_denial","latency"],"cost":"none per request"},
    {"id":"azure.deployment.apply","feature":"apply ARM/Bicep deployment","method":"PUT","path":"/{scope}/providers/Microsoft.Resources/deployments/{name}?api-version=2025-04-01","command":"az deployment group create","input":["immutable template","parameters","mode","idempotency key"],"output":["deployment id","operations","outputs","state"],"permission":"scoped custom deployment role","risk":"approval_required","monitor":["deployment_state","operations","cost_delta","activity_log"],"cost":"deployed resources billed"},
    {"id":"azure.deployment.operations","feature":"inspect or cancel deployment","method":"GET|POST","path":"/{scope}/providers/Microsoft.Resources/deployments/{name}/*","command":"az deployment operation group list|az deployment group cancel","input":["scope","deployment name"],"output":["operations or cancellation state"],"permission":"Reader for inspect; deployment action for cancel","risk":"controlled","monitor":["terminal_state","failure_code"],"cost":"none per request"},
    {"id":"azure.app_service.deploy","feature":"deploy web app","method":"PUT|POST","path":"/subscriptions/{subscriptionId}/resourceGroups/{rg}/providers/Microsoft.Web/sites/{name}/*","command":"az webapp deploy","input":["artifact","slot","configuration"],"output":["deployment state","hostname"],"permission":"Website Contributor or custom","risk":"controlled","monitor":["deployment","health","metrics","logs"],"cost":"App Service plan, traffic and logs"},
    {"id":"azure.function.deploy","feature":"deploy function application","method":"PUT|POST","path":"/subscriptions/{subscriptionId}/resourceGroups/{rg}/providers/Microsoft.Web/sites/{name}/*","command":"az functionapp deployment source config-zip","input":["artifact","runtime","settings"],"output":["deployment state","hostname"],"permission":"Website Contributor or custom","risk":"controlled","monitor":["invocations","errors","latency","cold_start"],"cost":"plan, execution, storage and logs"},
    {"id":"azure.container_app.deploy","feature":"deploy container app and revision","method":"PUT","path":"/subscriptions/{subscriptionId}/resourceGroups/{rg}/providers/Microsoft.App/containerApps/{name}","command":"az containerapp create|update","input":["image digest","environment","identity","secrets refs","scale"],"output":["revision","fqdn","state"],"permission":"Container Apps Contributor plus ACR pull","risk":"controlled","monitor":["revision","replicas","requests","errors"],"cost":"compute, requests, logs and egress"},
    {"id":"azure.aks.deploy","feature":"manage Kubernetes cluster and workloads","method":"PUT|GET","path":"/subscriptions/{subscriptionId}/resourceGroups/{rg}/providers/Microsoft.ContainerService/managedClusters/{name}","command":"az aks create|update|get-credentials","input":["cluster spec","identity","network","node pools"],"output":["cluster state","resource id"],"permission":"AKS Contributor plus scoped roles","risk":"approval_required","monitor":["control_plane","nodes","pods","policy","cost"],"cost":"nodes, control tier, disks, network and logs"},
    {"id":"azure.acr.image.push","feature":"store immutable container artifacts","method":"OCI registry API","path":"https://{registry}.azurecr.io/v2/*","command":"az acr login; docker push","input":["image","digest","provenance"],"output":["digest","manifest"],"permission":"AcrPush; AcrPull for runtime","risk":"controlled","monitor":["digest","scan","signing","retention"],"cost":"registry tier, storage, build and egress"},
    {"id":"azure.storage.provision","feature":"object, file, queue and table storage","method":"PUT","path":".../providers/Microsoft.Storage/storageAccounts/{name}","command":"az storage account create","input":["sku","kind","network","encryption"],"output":["account state","endpoints"],"permission":"Storage Account Contributor; separate data roles","risk":"approval_required","monitor":["availability","capacity","transactions","egress"],"cost":"capacity, operations, redundancy and egress"},
    {"id":"azure.database.provision","feature":"managed SQL, PostgreSQL, MySQL or Cosmos data service","method":"PUT","path":".../providers/{databaseNamespace}/{resourceType}/{name}","command":"service-specific az command or IaC","input":["engine","sku","network","backup","identity"],"output":["resource id","endpoint","state"],"permission":"service-specific contributor; separate data roles","risk":"approval_required","monitor":["availability","capacity","connections","backup","cost"],"cost":"compute, storage, backup, IOPS and network"},
    {"id":"azure.key_vault.manage","feature":"vault control plane and secret references","method":"PUT|GET","path":".../providers/Microsoft.KeyVault/vaults/{name}","command":"az keyvault create|show","input":["rbac","network","retention"],"output":["vault id","uri","state"],"permission":"Key Vault Contributor; separate secrets data role","risk":"approval_required","monitor":["audit_events","denials","rotation","expiry"],"cost":"operations, HSM tier and certificates"},
    {"id":"azure.rbac.read","feature":"inspect role definitions and assignments","method":"GET","path":"/{scope}/providers/Microsoft.Authorization/roleAssignments","command":"az role assignment list","input":["scope"],"output":["assignments"],"permission":"Reader","risk":"read_only","monitor":["assignment_drift"],"cost":"none per request"},
    {"id":"azure.rbac.write","feature":"change authorization","method":"PUT|DELETE","path":"/{scope}/providers/Microsoft.Authorization/roleAssignments/{id}","command":"az role assignment create|delete","input":["principal","role","scope"],"output":["assignment"],"permission":"User Access Administrator or Owner","risk":"approval_required","monitor":["activity_log","privilege_delta"],"cost":"none per request"},
    {"id":"azure.policy.manage","feature":"read or apply governance policy","method":"GET|PUT|DELETE","path":"/{scope}/providers/Microsoft.Authorization/policyAssignments/{name}","command":"az policy assignment list|create|delete","input":["definition","scope","parameters","identity"],"output":["assignment","compliance"],"permission":"Reader or Resource Policy Contributor","risk":"approval_required","monitor":["compliance","deny_events","remediation"],"cost":"resources and logs affected by policy"},
    {"id":"azure.monitoring.read","feature":"metrics, logs, activity and health","method":"GET|POST","path":"/providers/Microsoft.Insights/*|/providers/Microsoft.OperationalInsights/*","command":"az monitor metrics list|az monitor log-analytics query","input":["resource ids","metric or query","timespan"],"output":["series","records","health"],"permission":"Monitoring Reader and workspace query access","risk":"read_only","monitor":["query_latency","freshness","ingestion"],"cost":"log ingestion, retention, queries and alerts"},
    {"id":"azure.alerts.manage","feature":"metric, log and activity alerts","method":"PUT|DELETE","path":".../providers/Microsoft.Insights/{alertType}/{name}","command":"az monitor metrics alert create|delete","input":["scope","condition","action group"],"output":["alert rule"],"permission":"Monitoring Contributor or custom","risk":"controlled","monitor":["rule_state","fired","notification_delivery"],"cost":"alert rules, queries and notifications"},
    {"id":"azure.cost.read","feature":"query actual and forecast cost","method":"POST","path":"/{scope}/providers/Microsoft.CostManagement/query?api-version=2025-03-01","command":"az rest","input":["scope","timeframe","dataset"],"output":["rows","columns","currency"],"permission":"Cost Management Reader or billing-specific role","risk":"read_only","monitor":["freshness","budget_actual","forecast"],"cost":"none per request"},
    {"id":"azure.budget.manage","feature":"create and update spending guardrails","method":"GET|PUT|DELETE","path":"/{scope}/providers/Microsoft.Consumption/budgets/{name}","command":"az consumption budget create","input":["amount","period","thresholds","contacts"],"output":["budget","current spend"],"permission":"Cost Management Contributor or billing-specific role","risk":"approval_required","monitor":["threshold","notifications","forecast"],"cost":"none per request; does not automatically stop resources"},
    {"id":"azure.resource.delete","feature":"delete a resource","method":"DELETE","path":"/{resourceId}?api-version={pinnedVersion}","command":"az resource delete","input":["resource id","approval","backup evidence"],"output":["async operation state"],"permission":"resource delete action","risk":"approval_required","monitor":["activity_log","terminal_state","recovery"],"cost":"remaining retention, egress or deletion charges may apply"}
  ],
  "non_actions": [
    "Do not create tenants, subscriptions, billing accounts or support plans automatically.",
    "Do not grant Owner, User Access Administrator or broad Contributor to routine runners.",
    "Do not deploy preview API versions without a recorded exception.",
    "Do not delete resources, purge Key Vault, alter production networking or disable diagnostics without separate approval.",
    "Do not infer a fixed Azure price; resolve region, SKU, agreement and usage at execution time."
  ]
}

