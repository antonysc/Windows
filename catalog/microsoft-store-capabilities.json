{
  "schema_version": 1,
  "provider": "microsoft-store",
  "scope": "Windows application packaging and Partner Center publication",
  "reviewed_on": "2026-09-12",
  "interfaces": {
    "developer_cli_msix": "msstore CLI for MSIX/AppX applications",
    "developer_cli_msi_exe": "msstore CLI for externally hosted MSI/EXE installers",
    "store_submission_api": "https://api.store.microsoft.com/submission/v1",
    "legacy_submission_api": "https://manage.devcenter.microsoft.com/v1.0/my",
    "authentication": "Microsoft Entra OAuth2 client credentials; Store scope https://api.store.microsoft.com/.default"
  },
  "capabilities": [
    {"id":"microsoft-store.connectivity.check","feature":"verify Entra and Partner Center product access","method":"GET","path":"/submission/v1/product/{productId}/metadata?languages=en&includelanguagelist=false","command":"msstore submission get {productId}","input":["tenantId","clientId","credential","sellerId","productId"],"output":["bounded draft metadata status"],"permission":"Partner Center-linked Entra application","risk":"read_only","monitor":["http_status","correlation_id","latency","credential_age"],"cost":"none per request"},
    {"id":"microsoft-store.application.list","feature":"list applications","method":"GET","path":"legacy applications collection or CLI abstraction","command":"msstore apps list","input":["account context"],"output":["application ids and names"],"permission":"Partner Center application read","risk":"read_only","monitor":["count","permission_denial"],"cost":"none per request"},
    {"id":"microsoft-store.application.read","feature":"read application identity","method":"GET","path":"legacy application resource or CLI abstraction","command":"msstore apps get {applicationId}","input":["applicationId"],"output":["identity","productId","package identity"],"permission":"Partner Center application read","risk":"read_only","monitor":["not_found","schema_drift"],"cost":"none per request"},
    {"id":"microsoft-store.application.reserve_name","feature":"reserve initial product name","method":"UI bootstrap","path":"Partner Center","command":"manual Partner Center action","input":["product name"],"output":["productId"],"permission":"authorized Partner Center human","risk":"manual_only","monitor":["reservation_state"],"cost":"developer account terms apply"},
    {"id":"microsoft-store.cli.configure","feature":"configure CLI account context","method":"local","path":"local protected configuration","command":"msstore reconfigure","input":["tenantId","sellerId","clientId","secret or certificate"],"output":["configuration status"],"permission":"local runner secret access","risk":"controlled","monitor":["credential_source","configuration_age"],"cost":"none","warning":"never pass secrets on a shared command line"},
    {"id":"microsoft-store.package.initialize","feature":"initialize Store metadata in a project","method":"local","path":"project workspace","command":"msstore init {projectPath}","input":["WinUI|UWP|MAUI|Flutter|Electron|React Native|PWA project"],"output":["Store configuration"],"permission":"workspace write","risk":"controlled","monitor":["generated_files","tool_version"],"cost":"none"},
    {"id":"microsoft-store.package.build","feature":"build Store package","method":"local","path":"project workspace","command":"msstore package {projectPath}","input":["source","target architectures","version","signing reference"],"output":["MSIX/AppX upload bundle or package"],"permission":"build and signing service","risk":"controlled","monitor":["artifact_digest","signature","SBOM","build_log"],"cost":"runner and signing infrastructure"},
    {"id":"microsoft-store.package.validate","feature":"validate package before upload","method":"local","path":"Windows App Certification Kit","command":"appcert.exe test ...","input":["package","target Windows versions"],"output":["WACK report"],"permission":"Windows packaging runner","risk":"controlled","monitor":["validation_result","warnings","tool_version"],"cost":"runner time"},
    {"id":"microsoft-store.submission.read","feature":"read draft metadata and package","method":"GET","path":"/submission/v1/product/{productId}/metadata[/module]","command":"msstore submission get {productId}","input":["productId","languages","module"],"output":["listings","properties","availability","package"],"permission":"application read","risk":"read_only","monitor":["draft_state","listing_freshness"],"cost":"none per request"},
    {"id":"microsoft-store.submission.assets","feature":"read listing assets","method":"GET","path":"Store submission asset endpoint via CLI","command":"msstore submission getListingAssets {productId}","input":["productId","language"],"output":["asset metadata"],"permission":"application read","risk":"read_only","monitor":["asset_count","locales"],"cost":"none per request"},
    {"id":"microsoft-store.submission.metadata.update","feature":"update listings, properties or availability","method":"PUT","path":"/submission/v1/product/{productId}/metadata/{module}","command":"msstore submission updateMetadata {productId} {metadata}","input":["current draft","module JSON","locales","idempotency key"],"output":["module status","validation errors"],"permission":"application submission write","risk":"controlled","monitor":["correlation_id","validation","draft_state"],"cost":"none per request"},
    {"id":"microsoft-store.submission.package.update","feature":"attach MSIX/AppX or MSI/EXE package information","method":"PUT|POST","path":"Store package endpoint via CLI/API","command":"msstore submission update {productId} {package}","input":["current package JSON","immutable artifact or installer URL","digest"],"output":["package status","upload instructions"],"permission":"application submission write","risk":"controlled","monitor":["digest","upload_state","validation"],"cost":"runner/storage; EXE/MSI hosting and egress"},
    {"id":"microsoft-store.submission.publish","feature":"submit draft for certification and publication","method":"POST","path":"/submission/v1/product/{productId}/submit","command":"msstore submission publish {productId}","input":["ready modules","approval","release schedule"],"output":["submission state","correlation id","retry-after"],"permission":"application submission publish","risk":"approval_required","monitor":["certification_state","publish_state","correlation_id"],"cost":"Store commercial terms apply"},
    {"id":"microsoft-store.submission.status","feature":"poll draft, certification and publication status","method":"GET","path":"Store submission status endpoint","command":"msstore submission status|poll {productId}","input":["productId"],"output":["status","errors","poll interval"],"permission":"application read","risk":"read_only","monitor":["state_transition","retry_after","terminal_state"],"cost":"none per request"},
    {"id":"microsoft-store.submission.delete","feature":"delete a draft submission","method":"DELETE","path":"legacy or CLI submission resource","command":"msstore submission delete {productId}","input":["productId","submissionId","approval"],"output":["deletion state"],"permission":"application submission write","risk":"approval_required","monitor":["audit","terminal_state"],"cost":"none per request"},
    {"id":"microsoft-store.flight.list","feature":"list package flights","method":"GET","path":"legacy flights collection or CLI abstraction","command":"msstore flights list {applicationId}","input":["applicationId"],"output":["flights","audiences"],"permission":"application read","risk":"read_only","monitor":["flight_count","audience_drift"],"cost":"none per request"},
    {"id":"microsoft-store.flight.manage","feature":"create, update or delete a flight","method":"POST|PUT|DELETE","path":"legacy flight resources or CLI abstraction","command":"msstore flights create|get|delete|submission ...","input":["applicationId","flight","audience","package","approval"],"output":["flight state","submission state"],"permission":"application flight write","risk":"controlled","monitor":["audience","submission_state","rollout"],"cost":"none per request"},
    {"id":"microsoft-store.rollout.manage","feature":"configure gradual package rollout","method":"POST","path":"legacy rollout resource or CLI abstraction","command":"msstore submission rollout ...","input":["submissionId","percentage","halt or finalize","approval"],"output":["rollout state"],"permission":"application submission write","risk":"approval_required","monitor":["percentage","health","halt_state"],"cost":"commercial and telemetry terms apply"},
    {"id":"microsoft-store.pricing.manage","feature":"set price, markets, trials and visibility","method":"PUT","path":"/submission/v1/product/{productId}/metadata/availability","command":"msstore submission updateMetadata {productId} {availabilityJson}","input":["markets","price","trial","visibility","schedule"],"output":["availability validation"],"permission":"application submission write","risk":"approval_required","monitor":["market_delta","price_delta","schedule"],"cost":"commission, tax and regional terms"},
    {"id":"microsoft-store.analytics.read","feature":"read acquisition, health and usage reports where available","method":"GET","path":"Partner Center analytics APIs","command":"API adapter","input":["applicationId","date range","aggregation"],"output":["report rows","continuation"],"permission":"analytics read","risk":"read_only","monitor":["freshness","completeness","privacy"],"cost":"none per request"}
  ],
  "non_actions": [
    "Do not create the Partner Center account, legal profile, payout profile or first reserved app automatically.",
    "Do not commit CLI configuration, Entra secrets, certificates, seller IDs bound to secrets or package-signing material.",
    "Do not mutate pricing, audience, availability, submission, rollout or production publication without explicit approval.",
    "Do not publish mutable EXE/MSI installer URLs; pin immutable artifacts and hashes.",
    "Do not assume Partner Center roles constrain EXE/MSI apps; verify effective access on a dedicated test product.",
    "Do not log access tokens, upload URLs, Partner Center payloads or customer/financial analytics."
  ]
}

