{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/antonysc/Windows/contracts/deployment-input.schema.json",
  "title": "Windows provider deployment input",
  "type": "object",
  "additionalProperties": false,
  "required": ["pod", "account", "environment", "artifactDigest", "idempotencyKey"],
  "properties": {
    "pod": {"enum": ["azure", "microsoft-store"]},
    "account": {"type": "string", "minLength": 1},
    "environment": {"enum": ["development", "test", "staging", "production"]},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "approvalRef": {"type": "string", "minLength": 1},
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subscriptionId": {"type": "string"},
        "resourceGroup": {"type": "string"},
        "location": {"type": "string"},
        "template": {"type": "string"}
      }
    },
    "microsoftStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "packageType", "architectures", "languages", "markets", "publishMode"],
      "properties": {
        "productId": {"type": "string", "pattern": "^env://[A-Z][A-Z0-9_]*$"},
        "packageType": {"enum": ["exe", "msi", "msix", "pwa"]},
        "packagePath": {"type": "string"},
        "installerUrl": {"type": "string", "format": "uri"},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["x86", "x64", "arm64", "neutral"]}
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "markets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "flightId": {"type": "string"},
        "publishMode": {"enum": ["hold", "scheduled", "automatic"]}
      },
      "oneOf": [
        {"required": ["packagePath"]},
        {"required": ["installerUrl"]}
      ],
      "allOf": [
        {
          "if": {"properties": {"packageType": {"const": "msix"}}},
          "then": {"required": ["packagePath"]}
        },
        {
          "if": {"properties": {"packageType": {"enum": ["exe", "msi", "pwa"]}}},
          "then": {"required": ["installerUrl"]}
        }
      ]
    }
  }
}

