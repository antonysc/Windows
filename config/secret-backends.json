{
  "schema_version": 1,
  "backends": {
    "bitwarden_secrets_manager": {"status": "default", "reference": "secret://bitwarden/project/immutable-secret-id", "projects": ["stores-prod", "cloud-prod"], "requirements": ["store-publisher or cloud-runtime machine account", "read-only project access", "immutable IDs", "rotation", "audit log"]},
    "environment": {"status": "compatibility", "reference": "env://VARIABLE", "uses": ["protected masked GitLab variables", "GitHub repository or environment secrets", "ephemeral local process environment"]},
    "gitlab_oidc": {"status": "planned", "reference": "oidc://gitlab/project/ref", "requirements": ["short-lived token", "protected ref", "audience binding", "federated credential", "audit"]},
    "github_oidc": {"status": "planned", "reference": "oidc://github/repository/environment", "requirements": ["id-token permission", "subject binding", "federated credential", "environment approval"]},
    "azure_key_vault": {"status": "planned", "reference": "secret://azure-key-vault/vault/name/version", "requirements": ["workload identity", "version pinning", "rotation", "private endpoint policy", "audit log"]},
    "external_vault": {"status": "planned", "reference": "vault://mount/path#field", "requirements": ["short lease", "envelope encryption", "rotation", "least privilege", "audit log"]}
  },
  "forbidden": ["repository values", "command-line values", "shell history", "logs", "issues", "artifacts", "container images", "client-side bundles"]
}
